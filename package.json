{
  "name": "for-pocket",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A playful Telegram expense Mini App",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "start:prod": "node --env-file-if-exists=.env server.mjs",
    "bot": "node --env-file-if-exists=.env bot.mjs",
    "bot:configure": "node --env-file-if-exists=.env scripts/configure-bot.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup-data.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore-data.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@telegram-apps/telegram-ui": "2.1.13",
    "google-auth-library": "^11.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
