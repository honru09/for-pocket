{
  "name": "for-pocket",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A playful Telegram expense Mini App",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
