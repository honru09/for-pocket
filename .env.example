# Copy to .env. Keep .env private.
BOT_TOKEN=
# Optional override for the Telegram webhook header. If blank, a stable value is derived from BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=
# Secret header required by Cloud Scheduler and Cloud Tasks for /api/cron/*.
# Keep this in Secret Manager for production; an in-process fallback is generated when blank.
CRON_SECRET=
# Durable emoji notifications on Cloud Run. See docs/REACTION_NOTIFICATIONS.md.
# Cloud Tasks uses GOOGLE_CLOUD_PROJECT or the VERTEX_PROJECT_ID below.
REACTION_TASKS_QUEUE=
REACTION_TASKS_LOCATION=asia-northeast1
# Optional OIDC service account only when the Cloud Run target requires it.
REACTION_TASKS_SERVICE_ACCOUNT=
# Bot AI confirmation mode: false keeps the preview + confirm button; true saves after recognition.
TELEGRAM_AI_AUTO_CONFIRM=false
# Google OAuth Web client ID (never a client secret). Add PUBLIC_URL as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
PUBLIC_URL=https://for-pocket-698348906987.asia-northeast1.run.app
PORT=8787
HOST=127.0.0.1
# Persistent folder outside the public website. Default: ./data
DATA_DIR=./data
AUTH_MAX_AGE_SECONDS=86400
# Optional source commit identifier for deployment verification.
APP_COMMIT=
# Optional private backup destination; defaults to ./backups
BACKUP_DIR=
# Optional Gemini Vertex AI expense parser. Cloud Run uses Application Default Credentials.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_TEXT_MODEL=gemini-3.1-flash-lite
VERTEX_VISION_MODEL=gemini-3.1-flash-lite
VERTEX_SUMMARY_MODEL=gemini-3.1-flash-lite
# Optional model used for the manual image retry; defaults to Flash-Lite too.
VERTEX_ENHANCED_MODEL=gemini-3.1-flash-lite
# Optional single model override for all text and image requests.
VERTEX_MODEL=

# Cloud Run: leave false unless the instance has CPU available after responses.
# Local servers default to debounced asynchronous persistence.
STORE_ASYNC_PERSIST=false

# Optional one-shot geocoding. Photon is the modest-use default. Empty URL disables lookup.
# Switch to a private compatible endpoint if usage grows; no GPS watches run in the app.
GEO_REVERSE_PROVIDER=photon
GEO_REVERSE_URL=https://photon.komoot.io/reverse
GEO_USER_AGENT=for-pocket/0.5 (+https://github.com/honru09/for-pocket)
# Public Nominatim needs an explicit single-instance/application-wide rate-limit decision:
# https://operations.osmfoundation.org/policies/nominatim/
GEO_NOMINATIM_PUBLIC_SINGLE_INSTANCE=false
